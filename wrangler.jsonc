{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "currency-converter-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18"
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}